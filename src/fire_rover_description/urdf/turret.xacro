<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="water_tank" params="x">
    <link name="water_tank_link">
      <xacro:box_inertia mass="${tank_mass}" x="${tank_length}" y="${tank_width}" z="${tank_height}"/>
      <visual>
        <geometry><box size="${tank_length} ${tank_width} ${tank_height}"/></geometry>
        <material name="tank_white"/>
      </visual>
      <collision>
        <geometry><box size="${tank_length} ${tank_width} ${tank_height}"/></geometry>
      </collision>
    </link>
    <joint name="water_tank_joint" type="fixed">
      <parent link="base_link"/>
      <child link="water_tank_link"/>
      <origin xyz="${x} 0 ${chassis_height / 2 + tank_height / 2 + 0.01}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="fire_turret" params="">
    <link name="turret_base_link">
      <xacro:cylinder_inertia mass="0.25" radius="0.075" length="0.035"/>
      <visual>
        <geometry><cylinder radius="0.075" length="0.035"/></geometry>
        <material name="metal_gray"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.075" length="0.035"/></geometry>
      </collision>
    </link>
    <joint name="turret_base_joint" type="fixed">
      <parent link="water_tank_link"/>
      <child link="turret_base_link"/>
      <origin xyz="0 0 ${tank_height / 2 + 0.02}" rpy="0 0 0"/>
    </joint>

    <link name="turret_pan_link">
      <xacro:cylinder_inertia mass="0.20" radius="0.055" length="0.05"/>
      <visual>
        <geometry><cylinder radius="0.055" length="0.05"/></geometry>
        <material name="rover_blue"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.055" length="0.05"/></geometry>
      </collision>
    </link>
    <joint name="turret_pan_joint" type="revolute">
      <parent link="turret_base_link"/>
      <child link="turret_pan_link"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159" upper="3.14159" effort="3.0" velocity="1.0"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="turret_tilt_link">
      <xacro:box_inertia mass="0.16" x="0.12" y="0.07" z="0.045"/>
      <visual>
        <origin xyz="0.035 0 0" rpy="0 0 0"/>
        <geometry><box size="0.12 0.07 0.045"/></geometry>
        <material name="thermal_orange"/>
      </visual>
      <collision>
        <origin xyz="0.035 0 0" rpy="0 0 0"/>
        <geometry><box size="0.12 0.07 0.045"/></geometry>
      </collision>
    </link>
    <joint name="turret_tilt_joint" type="revolute">
      <parent link="turret_pan_link"/>
      <child link="turret_tilt_link"/>
      <origin xyz="0.025 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.35" upper="0.70" effort="2.0" velocity="0.8"/>
      <dynamics damping="0.1"/>
    </joint>

    <link name="nozzle_link">
      <xacro:cylinder_inertia mass="0.08" radius="0.012" length="0.16" origin_rpy="0 ${pi / 2} 0"/>
      <visual>
        <origin xyz="0.08 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.012" length="0.16"/></geometry>
        <material name="metal_gray"/>
      </visual>
      <collision>
        <origin xyz="0.08 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.012" length="0.16"/></geometry>
      </collision>
    </link>
    <joint name="nozzle_joint" type="fixed">
      <parent link="turret_tilt_link"/>
      <child link="nozzle_link"/>
      <origin xyz="0.08 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>